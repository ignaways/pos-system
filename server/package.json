{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env dist/index.js",
    "db:setup": "tsx --env-file-if-exists=../.env src/db/cli.ts setup",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@vercel/functions": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
