# Copy to .env (git-ignored). Leave DATABASE_URL empty to use the built-in local
# PGlite database in server/.pglite — no install needed.

# Neon: Dashboard -> your project -> Connect -> pooled connection string ("-pooler" in the host)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Show the "Reset demo data" button. Always on locally; set to "true" on Vercel to enable it there.
# ALLOW_DEMO_RESET="true"
